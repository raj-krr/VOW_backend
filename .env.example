# Server Configuration
PORT=8000
NODE_ENV=development

# Database Configuration
MONGO_URI=mongodb://127.0.0.1:27017/vow

# Security & JWT Tokens
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
ACCESS_TOKEN_SECRET=your_jwt_access_secret_here
WORKSPACE_JWT_SECRET=your_workspace_jwt_secret_here

# Redis Configuration
REDIS_URL=redis://127.0.0.1:6379
USE_REDIS=false

# Email SMTP Configuration (Nodemailer)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password

# AWS S3 Cloud Storage
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_BUCKET_NAME=vow-media-uploads

# Frontend & CORS Configuration
FRONTEND_URL=http://localhost:5173
FRONTEND_URL_DEV=http://localhost:5173
FRONTEND_URL_PROD=https://vow-org.me
RENDER_URL=https://vow-backend.onrender.com
